# Person A's extraction pipeline runs in-process, so the backend needs the key too.
GEMINI_API_KEY=your_key_here

# gemini-flash-lite-latest  — cheap, high daily quota, use for dev
# gemini-2.5-flash          — balanced
# gemini-3.5-flash          — best quality, only 20 free requests/day, use for demo day
GEMINI_MODEL=gemini-flash-lite-latest

# Person B's live Google search enrichment.
SERPAPI_KEY=your_key_here
